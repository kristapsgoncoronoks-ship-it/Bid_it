# InvoiceIQ — single-node VPS environment (copy to `.env`, fill in, keep secret).
# Used by docker-compose.hostinger.yml. NEVER commit the filled-in .env.

# --- Public identity ---------------------------------------------------------
# Your public HTTPS origin — the exact scheme+host users hit. Must match the TLS
# certificate's domain. Drives CORS.
APP_ORIGIN=https://app.example.com

# --- Secrets (generate real values — do NOT ship these examples) -------------
# JWT signing key. Generate: openssl rand -hex 32
# Rotating it logs everyone out AND — with the default KEK_PROVIDER=local — makes
# every sealed secret (tenant SSO client secrets) permanently unreadable, because
# the sealing key is derived from it. Back this file up beside the database
# (scripts/backup.sh does); a restore under a different SECRET_KEY is incomplete.
SECRET_KEY=change-me-openssl-rand-hex-32
# SEC-JWT-001: sign access tokens / SSO state with a key that is NOT the app
# secret, so a signature rotation never touches the local KEK. Leave empty to
# keep signing with SECRET_KEY. First enablement is a rotation: list the
# current SECRET_KEY as a fallback for 24 h (JSON list, max 3) or every
# session dies at the deploy. See docs/DEPLOYMENT.md.
JWT_SIGNING_KEY=
JWT_SIGNING_KEY_FALLBACKS=[]

# Postgres password for the bundled database container.
POSTGRES_PASSWORD=change-me-strong-db-password
# Optional overrides (defaults shown):
# POSTGRES_USER=invoiceiq
# POSTGRES_DB=invoiceiq

# Shared secret for the inbound-email webhook (POST /api/v1/email/inbound).
# REQUIRED: production refuses to boot without it, and the endpoint rejects
# every request (401) until the provider presents it (X-Inbound-Secret header).
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
INBOUND_EMAIL_SECRET=change-me-token-urlsafe-32

# --- Optional work calendars and email ---------------------------------------
# Configure the provider app registration first; each user must then connect
# their own account in the app. Leaving these empty keeps that provider disabled.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
# Public API callback origin and browser return origin default to APP_ORIGIN.
# Set an override only when the API and browser deliberately use different hosts.
# API_PUBLIC_BASE_URL=https://app.example.com
# CALENDAR_PUBLIC_APP_URL=https://app.example.com

# Optional SMTP relay. Empty SMTP_HOST means no configured delivery transport;
# the app must not report a successful external send for an unconfigured relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=billing@invoiceiq.app

# Optional extra consumer for short calendar/email jobs. It reuses the existing
# backend worker image and durable queue; the general worker continues all kinds.
# Enable when OCR occupies the only general worker, with enough VPS headroom.
# No extra worker starts by default, and provider/network latency is not a
# guaranteed instant-delivery SLA. Disable by removing this opt-in and stopping
# the old calendar-worker container deliberately (deployment also quiesces it).
# COMPOSE_PROFILES=calendar

# --- Tuning ------------------------------------------------------------------
# uvicorn workers. Use 2 on a 4 GB VPS (KVM 1); 4 on 8 GB+ (KVM 2+).
WEB_CONCURRENCY=4
# Upload body deadlines (seconds); defaults are also applied by Compose.
# Origin admission is two uploads per NGINX instance; API slots are per worker.
# UPLOAD_BODY_IDLE_SECONDS=30
# UPLOAD_BODY_TIMEOUT_SECONDS=300

# Directory on the HOST holding the TLS cert (origin.pem + origin.key). Defaults
# to ./certs next to the compose file if unset.
# TLS_CERT_DIR=./certs

# --- Images from GHCR (opt-in overlay docker-compose.images.yml, OPS-003) ----
# Only after `docker login ghcr.io` with a classic PAT (read:packages), see
# docs/DEPLOY-HOSTINGER.md "Images from GHCR". IMAGE_TAG is deliberately not
# defaulted: deploy the sha-<7> of the commit CI shipped, per deploy.
# GHCR_REPOSITORY=<owner>/<repo>
# IMAGE_TAG=sha-0000000
