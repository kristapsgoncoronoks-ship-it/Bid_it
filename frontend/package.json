{
  "name": "invoiceiq-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test e2e/smoke.spec.ts e2e/dashboard.spec.ts e2e/masters.spec.ts e2e/nav.spec.ts e2e/cash-position.spec.ts e2e/upload-duplicate.spec.ts e2e/vat-claims.spec.ts e2e/vat-admin.spec.ts e2e/recovery.spec.ts e2e/savings.spec.ts e2e/excise.spec.ts e2e/claim-status.spec.ts",
    "test:vr": "playwright test e2e/visual.spec.ts",
    "test:vr:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
