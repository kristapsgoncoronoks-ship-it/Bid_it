+async def _renew_lease(job_id: str, worker_id: str, org_id: str) -> bool:
+    """Renew one live lease using a separate transaction/session."""
+    from app.core.database import SessionLocal
+
+    token = set_current_org(org_id)
+    try:
+        now = _now()
+        async with SessionLocal() as heartbeat_db:
+            result = await heartbeat_db.execute(
+                update(Job)
+                .where(
+                    Job.id == job_id,
+                    Job.status == jobmodel.RUNNING,
+                    Job.locked_by == worker_id,
+                )
+                .values(locked_at=now, updated_at=now)
+            )
+            await heartbeat_db.commit()
+            return cast(CursorResult, result).rowcount == 1
+    finally:
+        reset_current_org(token)
+
+
+async def _heartbeat_loop(
+    job_id: str, worker_id: str, org_id: str, stop: asyncio.Event
+) -> None:
+    """Keep a claimed job live until its handler returns."""
+    while not stop.is_set():
+        try:
+            await asyncio.wait_for(stop.wait(), timeout=LEASE_HEARTBEAT_SECONDS)
+            return
+        except TimeoutError:
+            pass
+        try:
+            if not await _renew_lease(job_id, worker_id, org_id):
+                return
+        except Exception as exc:  # noqa: BLE001 - heartbeat must not fail business work
+            log.warning("job %s heartbeat failed: %s", job_id, exc)
 
 
