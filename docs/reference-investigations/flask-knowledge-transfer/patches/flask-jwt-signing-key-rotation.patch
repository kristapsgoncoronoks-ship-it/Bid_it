+    )
+
+
+def decode_internal_jwt(token: str) -> dict[str, Any]:
+    """Verify an InvoiceIQ-owned JWT with current key, then verify-only fallbacks.
+
+    Raises the last JWTError when no configured key validates. Callers choose
+    their own public error semantics (401 for access tokens, SsoError redirect
+    for OIDC state). No key identity is logged or exposed.
+    """
+    last_error: JWTError | None = None
+    for key in settings.jwt_verification_keys:
+        try:
+            return jwt.decode(token, key, algorithms=[settings.jwt_algorithm])
+        except JWTError as exc:
+            last_error = exc
+    assert last_error is not None
+    raise last_error
 
 
