+"""Freeze Stripe metered-usage reporting segments.
+
+Revision ID: e7f9a1c3d5b8
+Revises: c4d6e8f0a2b4
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+import sqlalchemy as sa
+from alembic import op
+
+revision: str = "e7f9a1c3d5b8"
+down_revision: str | None = "c4d6e8f0a2b4"
+branch_labels: str | Sequence[str] | None = None
+depends_on: str | Sequence[str] | None = None
+
+
+def upgrade() -> None:
+    op.add_column(
+        "usage_counters",
+        sa.Column("reporting_target", sa.Integer(), server_default="0", nullable=False),
+    )
+    # Existing `reported` is already the acknowledged cumulative watermark.
+    # Start with no in-flight segment.
+    op.execute(
+        sa.text(
+            "UPDATE usage_counters "
+            "SET reporting_target = reported "
+            "WHERE reporting_target <> reported"
+        )
+    )
+
+
+def downgrade() -> None:
+    op.drop_column("usage_counters", "reporting_target")

