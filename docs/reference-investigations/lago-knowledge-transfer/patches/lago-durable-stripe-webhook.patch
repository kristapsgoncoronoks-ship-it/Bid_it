+async def subscription_event_org_id(
+    db: AsyncSession, event: SubscriptionEvent
+) -> str | None:
+    """Resolve an actionable verified subscription event to its tenant.
+
+    The public Stripe webhook has no bearer-auth tenant context. This helper is
+    deliberately side-effect free so the route can decide whether there is
+    durable work to enqueue *before* acknowledging provider delivery.
+    """
+    if not event.customer_id or (event.plan_key is None and event.status is None):
+        return None
+    return await db.scalar(
+        select(Organization.id).where(Organization.stripe_customer_id == event.customer_id)
+    )
+
