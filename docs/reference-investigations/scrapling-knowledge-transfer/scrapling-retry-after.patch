From d30f90b69566b4d9055e597bd824932e25e4daf6 Mon Sep 17 00:00:00 2001
Subject: [PATCH] integrations: honor Retry-After without replacing queue backoff

Reference lesson: D4Vinci/Scrapling AutoThrottle treats Retry-After as
downstream backpressure and never lets it shorten local backoff.

InvoiceIQ adaptation:
- add a generic RetryAfterError hint understood by the existing durable queue;
- effective delay = max(queue exponential backoff, downstream hint);
- parse webhook Retry-After seconds and HTTP dates;
- invalid hints fall back to existing behavior;
- no schema, idempotency, payload, signature or SSRF behavior changes.

Base: d30f90b69566b4d9055e597bd824932e25e4daf6

diff --git a/backend/app/services/jobs.py b/backend/app/services/jobs.py
--- a/backend/app/services/jobs.py
+++ b/backend/app/services/jobs.py
@@
 Handler = Callable[[AsyncSession, dict, Job], Awaitable[dict | None]]
 _HANDLERS: dict[str, Handler] = {}

+
+class RetryAfterError(RuntimeError):
+    """A handler failure carrying a downstream minimum retry delay.
+
+    The queue still owns retry policy: this hint can make the next attempt
+    later, never earlier than the normal exponential backoff.
+    """
+
+    def __init__(self, message: str, *, retry_after_seconds: float) -> None:
+        super().__init__(message)
+        delay = float(retry_after_seconds)
+        if delay < 0:
+            raise ValueError("retry_after_seconds must be non-negative")
+        self.retry_after_seconds = delay
+
@@
-async def _fail(db: AsyncSession, job: Job, error: str, *, now: datetime | None = None) -> None:
