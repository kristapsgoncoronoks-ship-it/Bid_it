@@
 _TIMEOUT_SECONDS = 10


+def _parse_retry_after(value: str | None, *, now: datetime | None = None) -> float | None:
+    """Parse RFC Retry-After seconds or HTTP date.
+
+    Returns a non-negative delay in seconds. Garbage/non-finite values are
+    ignored so the queue falls back to its existing exponential backoff.
+    """
+    if not value:
+        return None
+    raw = value.strip()
+    if not raw:
+        return None
+
+    try:
+        seconds = float(raw)
+    except ValueError:
+        seconds = None
+    if seconds is not None:
+        if not math.isfinite(seconds):
+            return None
+        return max(seconds, 0.0)
+
+    try:
+        when = parsedate_to_datetime(raw)
+        if when.tzinfo is None:
+            when = when.replace(tzinfo=UTC)
+        current = now or datetime.now(UTC)
+        return max((when - current).total_seconds(), 0.0)
+    except (TypeError, ValueError, OverflowError):
+        return None
+
+
