+def test_retry_after_parser_supports_seconds_http_date_and_invalid_values():
+    now = datetime(2026, 9, 6, 16, 0, tzinfo=UTC)
+    assert webhooks._parse_retry_after("120", now=now) == 120.0
+    assert webhooks._parse_retry_after("-5", now=now) == 0.0
+    future = now + timedelta(seconds=90)
+    assert webhooks._parse_retry_after(format_datetime(future), now=now) == 90.0
+    for bad in ("", "soon", "12 seconds", "nan", "inf", "-inf"):
+        assert webhooks._parse_retry_after(bad, now=now) is None
