+    *,
+    now: datetime | None = None,
+    retry_after_seconds: float | None = None,
+) -> None:
     now = _now(now)
     job.last_error = error[:2000]
     job.locked_at = None
     job.locked_by = None
     if job.attempts >= job.max_attempts:
         job.status = jobmodel.DEAD
     else:
         job.status = jobmodel.QUEUED
-        job.run_after = now + timedelta(seconds=_backoff(job.attempts))
+        delay = float(_backoff(job.attempts))
+        if retry_after_seconds is not None:
+            # A downstream system may ask us to wait longer, but must never be
+            # able to undo our own protective backoff with a tiny/zero hint.
+            delay = max(delay, retry_after_seconds)
+        job.run_after = now + timedelta(seconds=delay)
     await db.commit()
@@
