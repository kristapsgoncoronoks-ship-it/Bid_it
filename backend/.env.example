# Copy to .env for local overrides. Defaults are dev-only.

# SQLite (zero setup) — good for local/dev/test:
DATABASE_URL=sqlite+aiosqlite:///./invoiceiq.db
# Postgres (production):
# DATABASE_URL=postgresql+asyncpg://invoiceiq:invoiceiq@localhost:5432/invoiceiq

# CHANGE IN PRODUCTION: openssl rand -hex 32
SECRET_KEY=dev-insecure-change-me

ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Production settings (see docs/DEPLOYMENT.md). Set these when ENVIRONMENT=production.
# ---------------------------------------------------------------------------
# HSTS_ENABLED=true

# Observability — LOG_JSON defaults to true in production; override here if needed.
# LOG_JSON=true
# METRICS_ENABLED=true

# Scaling / DB connection pool (Postgres). See DEPLOYMENT.md §7 for the
# connections math: replicas × WEB_CONCURRENCY × (POOL_SIZE + MAX_OVERFLOW).
# WEB_CONCURRENCY=4
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# Email intake webhook / outbound relay / malware scanning (all optional):
# INBOUND_EMAIL_SECRET=shared-secret
# SMTP_HOST=smtp.example.com
# SMTP_USER=apikey
# SMTP_PASSWORD=secret
# CLAMAV_ENABLED=true
