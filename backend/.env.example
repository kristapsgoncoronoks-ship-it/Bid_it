# Copy to .env for local overrides. Defaults are dev-only.

# SQLite (zero setup) — good for local/dev/test:
DATABASE_URL=sqlite+aiosqlite:///./invoiceiq.db
# Postgres (production):
# DATABASE_URL=postgresql+asyncpg://invoiceiq:invoiceiq@localhost:5432/invoiceiq

# CHANGE IN PRODUCTION: openssl rand -hex 32
SECRET_KEY=dev-insecure-change-me

ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Production settings (see docs/DEPLOYMENT.md). Set these when ENVIRONMENT=production.
# ---------------------------------------------------------------------------
# HSTS_ENABLED=true

# Observability — LOG_JSON defaults to true in production; override here if needed.
# LOG_JSON=true
# METRICS_ENABLED=true

# Scaling / DB connection pool (Postgres). See DEPLOYMENT.md §7 for the
# connections math: replicas × WEB_CONCURRENCY × (POOL_SIZE + MAX_OVERFLOW).
# WEB_CONCURRENCY=4
# Upload slots are per ASGI worker; no waiting-body queue (busy returns 503).
# UPLOAD_MAX_ACTIVE_REQUESTS=2
# Match the proxy's wire ceiling. Compose/Kubernetes already default to 20 MiB;
# unset on a standalone API retains the derived file/batch envelope.
# UPLOAD_MAX_BODY_MB=20
# Body reads only: seconds without bytes / total body-read seconds.
# UPLOAD_BODY_IDLE_SECONDS=30
# UPLOAD_BODY_TIMEOUT_SECONDS=300
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# Email intake webhook secret — REQUIRED in production (boot fails without it);
# the webhook 401s every request until the provider presents it. Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# INBOUND_EMAIL_SECRET=shared-secret
# Outbound relay / malware scanning (optional):
# SMTP_HOST=smtp.example.com
# SMTP_USER=apikey
# SMTP_PASSWORD=secret
# CLAMAV_ENABLED=true
