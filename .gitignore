# ── Secrets & certificates (NEVER commit) ──────────────────────────
.secret_key
cert.pem
key.pem
*.pfx
*.p12
fullchain.pem
privkey.pem

# ── Generated export files (regenerate, don't track) ──────────────
Pricing_Intel_*.xlsx
Fleet_Fuel_Summary_*.xlsx
Fleet_Fuel_Master_*.xlsx
Fleet_Fuel_History_Report.xlsx
VAT_Refund_Claims_*.xlsx
VAT_Claim_Readiness_*.xlsx
VAT_Fees_Statement_*.xlsx
VAT_Receivables_Forecast_*.xlsx
Internal_Benchmark_*.xlsx
Peer_Benchmark_*.xlsx
Savings_Intelligence_*.xlsx
Overpay_Review_*.xlsx
Expense_Report_*.xlsx
Accounting_Ledger_*.csv

# ── Fetched/cached reference data (re-fetchable) ──────────────────
ecb_rates.db

# ── Intake 'waiting room' queue (operational state, machine-specific) ──
intake.db

# ── Client-portal scraper: configs, ENCRYPTED credentials, run history ──
portal.db

# ── Data lake: archived uploads + AI-processed artifacts + index ──
data_lake.db
data_lake/

# ── Data-import log (audit of every import; machine-specific) ──
import_log.db

# ── VAT claim records — isolated DB, rebuilt by migration from fuel_history on
#    first run; on a real server this is LIVE data (back it up; see backup.py) ──
vat_claims.db

# ── Benchmark prices (my_prices/wholesale_prices) — app/portal-owned DB, split out
#    of fuel_history.db in D3; rebuilt by migration on first run, then LIVE data ──
benchmark.db

# ── Cross-process lock store + SQLite WAL sidecars (transient, machine-specific) ──
locks.db
*.db-wal
*.db-shm

# ── Runtime data & state (machine-specific) ────────────────────────
backups/
logs/
.extract_tmp/
inbox/
review_queue/
inbox_processed/
service.log
consolidated_rows.pkl
tls_*/
fullchain_*.pem

# ── Databases: see note below ──────────────────────────────────────
# By default we DO track the master-data + history DBs so a clone is
# usable, but NOT the security DB (contains password hashes & logins).
security.db

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# ── OS / editor noise ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Pytest security.db backup (transient)
*.pytest.bak
