# ── Secrets & certificates (NEVER commit) ──────────────────────────
.secret_key
cert.pem
key.pem
*.pfx
*.p12
fullchain.pem
privkey.pem

# ── Generated export files (regenerate, don't track) ──────────────
Pricing_Intel_*.xlsx
Fleet_Fuel_Summary_*.xlsx
Fleet_Fuel_Master_*.xlsx
Fleet_Fuel_History_Report.xlsx
VAT_Refund_Claims_*.xlsx
VAT_Claim_Readiness_*.xlsx
VAT_Fees_Statement_*.xlsx
VAT_Receivables_Forecast_*.xlsx
Internal_Benchmark_*.xlsx
Peer_Benchmark_*.xlsx
Savings_Intelligence_*.xlsx
Overpay_Review_*.xlsx
Expense_Report_*.xlsx
Accounting_Ledger_*.csv
SAFT_*.xml

# ── Fetched/cached reference data (re-fetchable) ──────────────────
ecb_rates.db

# ── Intake 'waiting room' queue (operational state, machine-specific) ──
intake.db

# ── Client-portal scraper: configs, ENCRYPTED credentials, run history ──
portal.db

# ── Data lake: archived uploads + AI-processed artifacts + index ──
data_lake.db
data_lake/

# ── Data-import log (audit of every import; machine-specific) ──
import_log.db

# ── VAT claim records — isolated DB, rebuilt by migration from fuel_history on
#    first run; on a real server this is LIVE data (back it up; see backup.py) ──
vat_claims.db

# ── Benchmark prices (my_prices/wholesale_prices) — app/portal-owned DB, split out
#    of fuel_history.db in D3; rebuilt by migration on first run, then LIVE data ──
benchmark.db

# ── Confidence-learning trust scores + validation-event ledger — app-owned runtime
#    DB (advisory-AI-review consumer only; never gates a legal check) ──
confidence.db

# ── Capture-confidence / learning loop — app-owned runtime DB: per-(supplier × field)
#    capture-accuracy counts (advisory hints on the review screen; never gates a legal
#    check; never mutates a figure; no demo data) ──
capture_confidence.db

# ── Embedded-finance advances ledger — finance-owned runtime DB (origination seam
#    over the recovery data; NULL provider by default, never gates a VAT figure) ──
finance.db

# ── Secure share links / data rooms — app-owned runtime DB (links, views, page
#    analytics, NDA acceptances, Q&A; no demo data) ──
sharing.db

# ── E-signature (②) — app-owned runtime DB: SES signature requests + signatures
#    (consent, audit fields, signed-doc SHA-256 binding, signed-PDF locator); no demo data ──
esign.db

# ── AI document-assistant chat history — app-owned runtime DB (advisory chat over a
#    document's DERIVED data only; never mutates a figure) ──
ai_chat.db

# ── Full-text search index (FTS5) — app-owned runtime DB, rebuilt read-only from the
#    product DBs by the close / the Admin 'Rebuild search index' action (no source data) ──
search.db

# ── Document metadata (A3) — app-owned runtime DB: typed custom fields + hierarchical
#    tags attached to vaulted documents by their reference (no product columns; no demo data) ──
metadata.db

# ── Document versioning (A4) — app-owned runtime DB: the ordered version chain of each
#    vaulted document, keyed by reference (no product columns; pointers only; no demo data) ──
versions.db

# ── Document retention + legal hold (A5) — app-owned runtime DB: retention policies +
#    legal holds keyed by reference (advisory; no product columns; no demo data) ──
retention.db

# ── Data classification / DLP — app-owned runtime DB: per-document sensitivity label +
#    finding {type,count} (NEVER raw values) keyed by reference (advisory; no demo data) ──
classify.db

# ── Cross-process lock store + SQLite WAL sidecars (transient, machine-specific) ──
locks.db
*.db-wal
*.db-shm

# ── Runtime data & state (machine-specific) ────────────────────────
backups/
logs/
.extract_tmp/
inbox/
review_queue/
inbox_processed/
service.log
consolidated_rows.pkl
tls_*/
fullchain_*.pem

# ── Databases: see note below ──────────────────────────────────────
# By default we DO track the master-data + history DBs so a clone is
# usable, but NOT the security DB (contains password hashes & logins).
security.db

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# ── OS / editor noise ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Pytest security.db backup (transient)
*.pytest.bak
