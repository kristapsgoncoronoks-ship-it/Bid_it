# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Databases / local data
*.db
*.sqlite3
smoke.db

# Node / frontend
node_modules/
frontend/dist/
*.local

# Env / secrets
.env
.env.*
!.env.example
!.env.hostinger.example

# PII quarantine (WO-6): the owner-held raw identifier list must NEVER be
# committed — only the salted-hash deny-list (scripts/pii_denylist.json) is.
# The scan cache is a local optimisation.
identifiers_for_denylist.txt
.pii_scan_cache.json

# Editor / OS
.DS_Store
.idea/
.vscode/

# TS incremental build cache
*.tsbuildinfo
backend/var/

# Playwright artifacts (also ignored under frontend/.gitignore; guard the root
# too, since a stray run from the repo root writes here)
test-results/
playwright-report/
blob-report/
